# Copy to .env.local and fill in. Both keys are server-side only.

# Speech recognition and fixture text-to-speech (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Commitment extraction (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override the extraction model (default claude-opus-5)
# EXTRACTION_MODEL=claude-opus-5

# Optional: allow the end-to-end suite to spend money against the live providers
# RUN_E2E=1
